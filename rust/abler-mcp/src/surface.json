  {
   "name": "list_child_schedules",
   "description": "Report schedules separately for each linked child: ID, display name, events, only that child's attendance, and independent pageInfo. Includes children with empty schedules. A shared event appears under each participating child. Defaults to all linked children; use childIds to select some.",
   "inputSchema": {
    "type": "object",
