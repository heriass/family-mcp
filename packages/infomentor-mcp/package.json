{
  "name": "infomentor-mcp",
  "version": "0.9.2",
  "description": "Local MCP server for Icelandic InfoMentor parent accounts with direct HTTP login",
  "keywords": [
    "iceland",
    "infomentor",
    "mcp",
    "school"
  ],
  "homepage": "https://github.com/olafurns7/family-mcp/tree/main/packages/infomentor-mcp#readme",
  "bugs": {
    "url": "https://github.com/olafurns7/family-mcp/issues"
  },
  "license": "MIT",
  "author": "Ólafur Nils Sigurðsson",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/olafurns7/family-mcp.git",
    "directory": "packages/infomentor-mcp"
  },
  "type": "module",
  "scripts": {
    "start": "bun src/cli.ts",
    "login": "bun src/cli.ts login",
    "check": "tsc --noEmit",
    "format": "oxfmt -c ../../.oxfmtrc.json --write .",
    "format:check": "oxfmt -c ../../.oxfmtrc.json --check .",
    "test": "bun test --timeout 30000 && python3 -I -B scripts/direct-route.test.py",
    "release:check": "node ../../tooling/release/render-install.mjs --package . --check && node ../../tooling/release/sync-version.mjs --package . --check",
    "build:binary": "node ../../tooling/release/build-binary.mjs --package .",
    "test:installer": "node ../../tooling/release/installer-test.mjs --package .",
    "lint": "oxlint -c ../../.oxlintrc.json --deny-warnings --report-unused-disable-directives-severity error src test",
    "typecheck": "tsc --noEmit",
    "lint:fix": "bun run lint --fix",
    "test:binary": "node ../../tooling/release/mcp-smoke.mjs --package . --bin release/native/infomentor-mcp --standalone",
    "release:sync": "node ../../tooling/release/sync-version.mjs --package ."
  },
  "dependencies": {
    "@family-mcp/mcp-runtime": "workspace:^",
    "@family-mcp/session-store": "workspace:*",
    "@modelcontextprotocol/server": "^2.0.0",
    "htmlparser2": "^12.0.0",
    "tough-cookie": "^6.0.2",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@family-mcp/oxlint-anti-slop": "workspace:*",
    "@family-mcp/release-tooling": "workspace:*",
    "@family-mcp/tsconfig": "workspace:*",
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/bun": "^1.2.19",
    "@types/node": "^22.20.2"
  },
  "packageManager": "bun@1.4.2",
  "familyMcp": {
    "release": {
      "rust": "infomentor-mcp",
      "tools": [
        "infomentor_session_status",
        "infomentor_get_overview",
        "infomentor_select_child",
        "infomentor_get_messages",
        "infomentor_get_message",
        "infomentor_get_notifications",
        "infomentor_collect_updates"
      ],
      "extraFiles": [
        {
          "source": "scripts/direct-route.py",
          "destination": "libexec/direct-route.py",
          "platform": "linux"
        },
        {
          "source": "scripts/warp.sh",
          "destination": "libexec/warp.sh",
          "platform": "linux"
        },
        {
          "source": "scripts/warp-launcher.sh",
          "destination": "bin/infomentor-mcp-warp",
          "platform": "linux",
          "executable": true
        }
      ]
    }
  }
}
