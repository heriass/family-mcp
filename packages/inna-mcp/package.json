{
  "name": "inna-mcp",
  "version": "0.4.2",
  "description": "Unofficial Inna school MCP with electronic-ID login, private sessions, and confirmed absence requests",
  "license": "MIT",
  "author": "Ólafur Nils Sigurðsson",
  "type": "module",
  "scripts": {
    "start": "bun src/cli.ts",
    "test": "bun test --timeout 30000",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint -c ../../.oxlintrc.json --deny-warnings --report-unused-disable-directives-severity error src test",
    "format": "oxfmt -c ../../.oxfmtrc.json --write .",
    "format:check": "oxfmt -c ../../.oxfmtrc.json --check .",
    "check": "bun run typecheck && bun run lint && bun run format:check",
    "build:binary": "node ../../tooling/release/build-binary.mjs --package .",
    "test:binary": "node ../../tooling/release/mcp-smoke.mjs --package . --bin release/native/inna-mcp --standalone",
    "test:installer": "node ../../tooling/release/installer-test.mjs --package .",
    "release:sync": "node ../../tooling/release/sync-version.mjs --package .",
    "release:check": "node ../../tooling/release/render-install.mjs --package . --check && node ../../tooling/release/sync-version.mjs --package . --check"
  },
  "dependencies": {
    "@family-mcp/mcp-runtime": "workspace:^",
    "@family-mcp/session-store": "workspace:*",
    "@modelcontextprotocol/server": "^2.0.0",
    "htmlparser2": "^12.0.0",
    "tough-cookie": "^6.0.2",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@family-mcp/oxlint-anti-slop": "workspace:*",
    "@family-mcp/release-tooling": "workspace:*",
    "@family-mcp/tsconfig": "workspace:*",
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/bun": "^1.2.19",
    "@types/node": "^22.20.2"
  },
  "packageManager": "bun@1.4.2",
  "familyMcp": {
    "release": {
      "rust": "inna-mcp",
      "tools": [
        "inna_session_status",
        "inna_list_students",
        "inna_get_overview",
        "inna_get_timetable",
        "inna_get_assignments",
        "inna_get_assignment",
        "inna_get_grades",
        "inna_get_course_grades",
        "inna_get_attendance",
        "inna_get_materials",
        "inna_get_messages",
        "inna_get_message",
        "inna_get_absences",
        "inna_absence_status"
      ]
    }
  }
}
